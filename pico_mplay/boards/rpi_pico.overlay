/*
 * Neither rpi_pico nor rpi_pico2 define a `led0` alias in this Zephyr tree,
 * so the standard samples/basic/blinky-style DT_ALIAS(led0) pattern needs
 * this one-time overlay. GPIO25 is the onboard LED on the plain (non-W)
 * Pico 2, same pin as the original Pico.
 */
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	aliases {
		led0 = &led0;
	};

	leds {
		compatible = "gpio-leds";
		led0: led_0 {
			gpios = <&gpio0 25 GPIO_ACTIVE_HIGH>;
		};
	};
};

/*
 * Both disabled by default; pinctrl (GPIO25 -> PWM slice 4 channel B) is
 * already wired up at board level (pwm_ch4b_default), so enabling status is
 * all that's needed here.
 */
&pwm {
	status = "okay";
};

&dma {
	status = "okay";
};

/*
 * No pinctrl group needed here: i2s_out_program_init()-equivalent code in
 * main.c routes GP26/27/28 to the PIO block via raw pico_gpio_init() calls
 * (same as the bare-metal version), bypassing Zephyr's pinctrl subsystem
 * entirely for this peripheral.
 */
&pio0 {
	status = "okay";
};

/*
 * Classic ESP32 boards via the in-tree esp32_devkitc/esp32/procpu target,
 * e.g. the LilyGO T5 V2.3.1 (ESP32-D0WDQ6-V3, 4 MB flash, no PSRAM):
 * console on UART0 (the board's USB-serial chip, CH9102 on the T5, 115200),
 * SCD41 and SHT40 on I2C0 = SDA GPIO21, SCL GPIO22 (already configured by
 * the board, 100 kHz - also the SCD41's maximum).
 */

/ {
    aliases {
        env-sensor = &scd41;
    };
};

&i2c0 {
    scd41: scd41@62 {
		compatible = "sensirion,scd41";
		reg = <0x62>;
		mode = <0>; // Normal 5s period
	};
};
